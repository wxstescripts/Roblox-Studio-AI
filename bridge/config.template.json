{
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "cors_origins": [
      "https://wxstescripts.github.io",
      "http://localhost:8765",
      "http://127.0.0.1:8765"
    ]
  },
  "auth": {
    "auth_key": "REPLACE_WITH_YOUR_SECURE_AUTH_PASSPHRASE_OR_TOKEN",
    "developers": {
      "REPLACE_WITH_LEAD_TOKEN": {
        "id": "dev_lead",
        "name": "Project Lead",
        "role": "lead",
        "agent": "Antigravity-Lead-IDE"
      },
      "REPLACE_WITH_DEV1_TOKEN": {
        "id": "dev_1",
        "name": "Frontend & UI Dev",
        "role": "developer",
        "agent": "Antigravity-Dev1-IDE"
      },
      "REPLACE_WITH_DEV2_TOKEN": {
        "id": "dev_2",
        "name": "Systems & Mining Dev",
        "role": "developer",
        "agent": "Antigravity-Dev2-IDE"
      }
    }
  },
  "bridge": {
    "auto_claim": false,
    "copy_to_clipboard": true,
    "notify_on_claim": true,
    "queue_dir": ".queue",
    "staged_prompt_file": ".queue/staged_prompt.md",
    "log_file": ".queue/audit.log"
  },
  "safety": {
    "max_prompt_length": 25000,
    "default_mode": "plan-first",
    "require_approval_for_execute": true,
    "disallowed_execution_patterns": [
      "rm -rf /",
      "del /f /s /q c:\\",
      "Format-Volume",
      "format c:"
    ]
  }
}
